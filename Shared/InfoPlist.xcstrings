    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr reads your weight, body composition and heart rate to show your progress."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr leest je gewicht, lichaamssamenstelling en hartslag om je vooruitgang te laten zien."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr saves your gym workouts, calories and weight in Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr bewaart je trainingen, calorieën en gewicht in Apple Gezondheid."
