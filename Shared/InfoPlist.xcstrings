    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr чете теглото, телесния състав и пулса ти, за да показва прогреса ти."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Liftr llegeix el teu pes, la composició corporal i la freqüència cardíaca per mostrar-te el teu progrés."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr čte tvou hmotnost, složení těla a tepovou frekvenci, aby ti ukázal tvůj pokrok."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr læser din vægt, kropssammensætning og puls for at vise dine fremskridt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr liest dein Gewicht, deine Körperzusammensetzung und deinen Puls, um deinen Fortschritt zu zeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Liftr διαβάζει το βάρος, τη σύσταση σώματος και τους καρδιακούς παλμούς σου για να σου δείξει την πρόοδό σου."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr reads your weight, body composition and heart rate to show your progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr lee tu peso, tu composición corporal y tu frecuencia cardiaca para mostrarte tu progreso."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr loeb sinu kaalu, keha koostist ja pulssi, et näidata sinu arengut."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr lukee painosi, kehonkoostumuksesi ja sykkeesi näyttääkseen edistymisesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr lit ton poids, ta composition corporelle et ta fréquence cardiaque pour te montrer tes progrès."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Léann Liftr do mheáchan, comhdhéanamh coirp agus ráta croí chun do dhul chun cinn a thaispeáint."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr čita tvoju težinu, sastav tijela i puls kako bi prikazao tvoj napredak."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Liftr kiolvassa a testsúlyodat, testösszetételedet és pulzusodat, hogy megmutassa a fejlődésedet."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr les þyngd, líkamssamsetningu og púls til að sýna framfarirnar þínar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr legge peso, composizione corporea e battito cardiaco per mostrarti i tuoi progressi."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr nuskaito tavo svorį, kūno sudėtį ir pulsą, kad parodytų tavo pažangą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr nolasa tavu svaru, ķermeņa sastāvu un pulsu, lai parādītu tavu progresu."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr ги чита твојата тежина, составот на телото и пулсот за да го прикаже твојот напредок."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr jaqra l-piż, il-kompożizzjoni tal-ġisem u r-rata tal-qalb tiegħek biex juri l-progress tiegħek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr leser vekt, kroppssammensetning og puls for å vise fremgangen din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr leest je gewicht, lichaamssamenstelling en hartslag om je vooruitgang te laten zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr odczytuje Twoją wagę, skład ciała i tętno, aby pokazywać Twoje postępy."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liftr lê o teu peso, composição corporal e frequência cardíaca para mostrar o teu progresso."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr îți citește greutatea, compoziția corporală și pulsul ca să-ți arate progresul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr считывает твой вес, состав тела и пульс, чтобы показывать твой прогресс."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr číta tvoju hmotnosť, zloženie tela a tep, aby ti ukázal tvoj pokrok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr bere tvojo težo, sestavo telesa in srčni utrip, da ti prikaže tvoj napredek."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr lexon peshën, përbërjen trupore dhe rrahjet e zemrës për të treguar progresin tënd."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr чита твоју тежину, састав тела и пулс да би приказао твој напредак."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr läser din vikt, kroppssammansättning och puls för att visa dina framsteg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr ilerlemeni göstermek için kilonu, vücut kompozisyonunu ve nabzını okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr зчитує твою вагу, склад тіла й пульс, щоб показувати твій прогрес."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr запазва фитнес тренировките, калориите и теглото ти в Здраве."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Liftr desa els teus entrenaments de gimnàs, les calories i el pes a l'app Salut."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr ukládá tvé tréninky v posilovně, kalorie a hmotnost do aplikace Zdraví."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr gemmer dine træningspas, kalorier og vægt i Sundhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr sichert deine Krafttrainings, Kalorien und dein Gewicht in Apple Health."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Liftr αποθηκεύει τις προπονήσεις γυμναστηρίου, τις θερμίδες και το βάρος σου στην Υγεία."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr saves your gym workouts, calories and weight in Apple Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr guarda tus entrenos de gimnasio, calorías y peso en Salud."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr salvestab sinu jõusaalitreeningud, kalorid ja kaalu rakendusse Tervis."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr tallentaa salitreenisi, kalorit ja painosi Terveyteen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr enregistre tes séances de musculation, tes calories et ton poids dans Santé."
          }
        },
        "ga": {
          "stringUnit": {
            "state": "translated",
            "value": "Sábhálann Liftr do sheisiúin ghiomnáisiam, calraí agus meáchan in Apple Health."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr sprema tvoje treninge u teretani, kalorije i težinu u aplikaciju Zdravlje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Liftr elmenti a konditermi edzéseidet, kalóriáidat és testsúlyodat az Egészség appba."
          }
        },
        "is": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr vistar æfingarnar, hitaeiningarnar og þyngdina þína í Heilsu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr salva i tuoi allenamenti in palestra, le calorie e il peso in Salute."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr išsaugo tavo sporto klubo treniruotes, kalorijas ir svorį programėlėje Sveikata."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr saglabā tavus sporta zāles treniņus, kalorijas un svaru lietotnē Veselība."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr ги зачувува твоите тренинзи во теретана, калориите и тежината во Здравје."
          }
        },
        "mt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr jissalva t-taħriġiet tal-gym, il-kaloriji u l-piż tiegħek f'Apple Health."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr lagrer treningsøktene, kaloriene og vekten din i Helse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr bewaart je trainingen, calorieën en gewicht in Apple Gezondheid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr zapisuje Twoje treningi na siłowni, kalorie i wagę w aplikacji Zdrowie."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Liftr guarda os teus treinos de ginásio, calorias e peso na app Saúde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr salvează antrenamentele de la sală, caloriile și greutatea în Sănătate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr сохраняет твои тренировки, калории и вес в приложении «Здоровье»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr ukladá tvoje tréningy v posilňovni, kalórie a hmotnosť do aplikácie Zdravie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr shranjuje tvoje treninge v fitnesu, kalorije in težo v aplikacijo Zdravje."
          }
        },
        "sq": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr ruan stërvitjet e palestrës, kaloritë dhe peshën tënde në Apple Health."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr чува твоје тренинге у теретани, калорије и тежину у апликацији Здравље."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr sparar dina gympass, kalorier och vikt i Hälsa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr spor salonu antrenmanlarını, kalorilerini ve kilonu Sağlık'a kaydeder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr зберігає твої тренування, калорії та вагу в програмі «Здоровʼя»."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr използва камерата, за да сканира QR кода или баркода на фитнес картата ти."
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El Liftr fa servir la càmera per escanejar el codi QR o de barres del teu carnet del gimnàs."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr používá fotoaparát ke skenování QR kódu nebo čárového kódu tvé permanentky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr bruger kameraet til at scanne QR-koden eller stregkoden på dit medlemskort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
