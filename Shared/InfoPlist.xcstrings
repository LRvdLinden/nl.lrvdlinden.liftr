    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr reads your weight, body composition and heart rate to show your progress."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr leest je gewicht, lichaamssamenstelling en hartslag om je vooruitgang te laten zien."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr saves your gym workouts, calories and weight in Apple Health."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr bewaart je trainingen, calorieën en gewicht in Apple Gezondheid."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr uses the camera to scan the QR code or barcode of your gym pass."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr gebruikt de camera om de QR- of barcode van je sportschoolpas te scannen."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr reads the code of your gym pass from a screenshot you choose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftr leest de code van je sportschoolpas uit een screenshot die je kiest."
          }
        }
      }
    }
  }
