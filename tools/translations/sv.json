 "appinfo.version": "Version",
 "plist.NSHealthShareUsageDescription": "Liftr läser din vikt, kroppssammansättning och puls för att visa dina framsteg.",
 "plist.NSHealthUpdateUsageDescription": "Liftr sparar dina gympass, kalorier och vikt i Hälsa.",
 "plist.NSCameraUsageDescription": "Liftr använder kameran för att skanna QR-koden eller streckkoden på ditt gymkort.",
 "plist.NSPhotoLibraryUsageDescription": "Liftr läser koden på ditt gymkort från en skärmbild som du väljer.",
