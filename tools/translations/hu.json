 "appinfo.version": "Verzió",
 "plist.NSHealthShareUsageDescription": "A Liftr kiolvassa a testsúlyodat, testösszetételedet és pulzusodat, hogy megmutassa a fejlődésedet.",
 "plist.NSHealthUpdateUsageDescription": "A Liftr elmenti a konditermi edzéseidet, kalóriáidat és testsúlyodat az Egészség appba.",
 "plist.NSCameraUsageDescription": "A Liftr a kamerát használja a konditermi bérleted QR-kódjának vagy vonalkódjának beolvasásához.",
