 "appinfo.version": "Versjon",
 "plist.NSHealthShareUsageDescription": "Liftr leser vekt, kroppssammensetning og puls for å vise fremgangen din.",
 "plist.NSHealthUpdateUsageDescription": "Liftr lagrer treningsøktene, kaloriene og vekten din i Helse.",
 "plist.NSCameraUsageDescription": "Liftr bruker kameraet til å skanne QR-koden eller strekkoden på medlemskortet ditt.",
 "plist.NSPhotoLibraryUsageDescription": "Liftr leser koden på medlemskortet ditt fra et skjermbilde du velger.",
